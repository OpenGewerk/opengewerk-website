---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  /**
   * Marks a picture that does not show the screen as it is built: either the
   * screen does not exist yet, or it exists and looks different from the
   * design. Only a picture that matches what was built goes without it.
   */
  draft?: boolean;
  /**
   * A phone screen gets a narrow frame, a desktop screen the full band. Left
   * out it follows the picture itself, which is the only place where this is
   * never wrong: a portrait export is a phone.
   */
  form?: 'wide' | 'phone';
  /** The first image on a page is not lazy, it is the one being waited for. */
  eager?: boolean;
  /** Beside the heading of a dark hero: a deeper shadow with a copper glow. */
  hero?: boolean;
}

const { src, alt, caption, draft = false, eager = false, hero = false } = Astro.props;

// Deriving this rather than asking for it: passing the shape by hand put a
// 390 px phone screen into a 1216 px frame once, and it looked broken in a way
// that no test would have caught. The aspect ratio is right there in the file.
const form = Astro.props.form ?? (src.height > src.width ? 'phone' : 'wide');

// The sources are 2x exports of the boards, so a sharp screen gets twice the
// pixels of the frame. Asking for widths above the original would only make
// Astro upscale, so the list stops at the real width of the file.
const widthSteps =
  form === 'phone'
    ? [320, 390, 640, 780].filter((candidate) => candidate <= src.width)
    : [640, 960, 1280, 1920, 2560].filter((candidate) => candidate <= src.width);

const sizes =
  form === 'phone'
    ? '(width >= 30rem) 20rem, calc(100vw - 3rem)'
    : '(width >= 82rem) 76rem, calc(100vw - 3rem)';

// The enlarged view gets the whole file at its own width. Without JavaScript
// the link opens exactly this file, so the picture can still be enlarged.
const full = await getImage({ src, width: src.width, format: 'webp' });
---

<figure class:list={['shot', form === 'phone' && 'shot-phone', hero && 'shot-hero']}>
  <a
    class="shot-frame"
    href={full.src}
    data-zoom
    data-width={src.width}
    data-height={src.height}
  >
    <span class="sr-only">Bild vergrößern: </span>
    <Image
      src={src}
      alt={alt}
      widths={widthSteps}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
    />
    <span class="shot-hint" aria-hidden="true">Vergrößern</span>
  </a>
  <figcaption>
    {draft && <span class="badge badge-partial">Entwurf</span>}
    <span>{caption}</span>
  </figcaption>
</figure>

<style>
  /* The width limit sits on the whole figure, not on the frame. With it on the
   * frame the caption kept the full column width while the picture was narrow,
   * and a caption wider than the thing it captions does not read as belonging
   * to it. The exports are 1x, so beyond their own width the picture would only
   * get soft, not bigger. */
  .shot {
    margin: 0;
    max-width: 1280px;
    margin-inline: auto;
  }

  .shot-phone {
    max-width: 20rem;
  }

  .shot-frame {
    position: relative;
    display: block;
    cursor: zoom-in;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-image);
    background: var(--surface);
  }

  .shot-hero .shot-frame {
    border-color: rgb(244 241 234 / 0.14);
    box-shadow:
      0 30px 80px -24px rgb(0 0 0 / 0.65),
      0 0 120px -36px rgb(200 103 31 / 0.6);
  }

  .shot-phone .shot-frame {
    border-radius: 20px;
  }

  .shot-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The hint says what a click does. It is always there on a touch screen,
   * where nothing hovers, and on a pointer it comes with hover and focus. */
  .shot-hint {
    position: absolute;
    inset-block-end: 0.75rem;
    inset-inline-end: 0.75rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-s);
    background: var(--ink);
    color: var(--ink-on-dark);
    font-size: var(--font-s);
    font-weight: 600;
  }

  @media (hover: hover) {
    .shot-hint {
      opacity: 0;
    }

    .shot-frame:hover .shot-hint,
    .shot-frame:focus-visible .shot-hint {
      opacity: 1;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .shot-hint {
      transition: opacity 150ms ease;
    }
  }

  figcaption {
    margin-block-start: var(--space-xs);
    font-size: var(--font-s);
    color: var(--ink-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    text-align: left;
  }

  .section-dark figcaption {
    color: var(--ink-muted-on-dark);
  }
</style>
