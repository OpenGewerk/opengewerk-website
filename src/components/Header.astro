---
import { NAVIGATION, LINKS } from '../site';

// A page is current when its path is the one being rendered. The trailing slash
// is part of it, the site is configured to always carry one. A page below an
// entry, such as the state of the Haustechnik under /haustechnik/, marks its
// entry as the section the reader is in.
const here = Astro.url.pathname;
const currentFor = (href: string, also: readonly string[]) =>
  here === href
    ? 'page'
    : [href, ...also].some((prefix) => prefix !== '/' && here.startsWith(prefix))
      ? 'true'
      : undefined;
---

<header class="header">
  <div class="wrap header-inner">
    <a class="header-brand" href="/">
      {/* The link's name is text, which a crawler and a screen reader both read;
          an aria-label is read by the second only (#66). */}
      <span class="sr-only">OpenGewerk, zur Startseite</span>
      <img
        src="/marke/logo.svg"
        alt=""
        width="476"
        height="100"
        fetchpriority="high"
      />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-navigation"
      hidden
    >
      <svg class="icon-open" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
      <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M5 5l14 14M19 5L5 19" />
      </svg>
      <span>Menü</span>
    </button>

    <nav id="main-navigation" aria-label="Hauptnavigation">
      <ul class="header-nav">
        {
          NAVIGATION.map((entry) => (
            <li>
              <a href={entry.href} aria-current={currentFor(entry.href, entry.also)}>
                {entry.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="header-github" href={LINKS.github} rel="noopener">GitHub</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

{/*
  Progressive enhancement. The markup ships with the navigation visible and the
  button hidden, so a browser without JavaScript keeps a working, wrapping list
  instead of a menu that cannot be opened. /scripts/header.js, loaded in the
  <head> of Page.astro, marks the page with html[data-js] before the first
  paint, and the CSS below collapses the list into a burger from then on.
*/}

<style>
  .header {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    padding-block: var(--space-s);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
  }

  .header-brand {
    display: block;
    flex: 0 0 auto;
  }

  .header-brand img {
    /* Never below the 120 px minimum size from the brand guide. */
    width: clamp(9rem, 13vw, 11rem);
    height: auto;
  }

  .header-nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem clamp(0.75rem, 1.4vw, 1.5rem);
    font-size: var(--font-s);
  }

  .header-nav a {
    color: var(--ink);
    text-decoration: none;
    display: inline-block;
    padding-block: 0.4rem;
    border-bottom: 2px solid transparent;
    font-weight: 500;
  }

  .header-nav a:hover {
    color: var(--copper-text);
    border-bottom-color: var(--copper);
  }

  .header-nav a[aria-current] {
    color: var(--copper-text);
    border-bottom-color: var(--copper);
    font-weight: 600;
  }

  .header-github {
    color: var(--ink-muted) !important;
  }

  /* The button shows only where the script marked the page (html[data-js]),
   * then the display below wins over [hidden], which the script lifts once the
   * header is parsed. */
  .nav-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--font-s);
    font-weight: 600;
    cursor: pointer;
  }

  .nav-toggle svg {
    width: 1.35rem;
    height: 1.35rem;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    fill: none;
  }

  .nav-toggle .icon-close,
  .header[data-open] .nav-toggle .icon-open {
    display: none;
  }

  .header[data-open] .nav-toggle .icon-close {
    display: block;
  }

  /* Below the width at which the seven entries still fit on one line, the
   * navigation becomes a burger menu. Measured, not guessed: at 768 px the row
   * still fits, underneath it starts to wrap. */
  @media (width < 48rem) {
    :global(html[data-js]) .nav-toggle {
      display: inline-flex;
    }

    :global(html[data-js]) .header nav {
      display: none;
      width: 100%;
    }

    :global(html[data-js]) .header[data-open] nav {
      display: block;
    }

    :global(html[data-js]) .header-nav {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin-block-start: var(--space-xs);
      border-top: 1px solid var(--line);
      font-size: var(--font-m);
    }

    :global(html[data-js]) .header-nav a {
      display: block;
      padding: 0.75rem 0.25rem;
      min-height: 44px;
      border-bottom: 1px solid var(--line);
      border-left: 3px solid transparent;
      padding-left: 0.75rem;
    }

    :global(html[data-js]) .header-nav a:hover,
    :global(html[data-js]) .header-nav a[aria-current] {
      border-bottom-color: var(--line);
      border-left-color: var(--copper);
      background: var(--surface-sunken);
    }
  }
</style>
