---
// One dialog per page shows any screenshot large. Every screenshot is a link
// to its full file, so without JavaScript the browser opens that file and
// nothing is lost; this script only turns the click into the dialog.
//
// The picture opens fitted to the window, whatever its shape, so a phone
// screen and an office screen both show whole. From there it zooms in steps,
// with the buttons, the keys + - 0 or a click on the picture.
---

<dialog class="lightbox" aria-labelledby="lightbox-caption">
  <div class="lightbox-bar">
    <p id="lightbox-caption" class="lightbox-caption"></p>
    <div class="lightbox-tools">
      <button type="button" class="lightbox-tool" data-zoom-step="-1" aria-label="Verkleinern">
        <span aria-hidden="true">−</span>
      </button>
      <button type="button" class="lightbox-tool lightbox-level" data-zoom-fit aria-label="Einpassen">
        100&nbsp;%
      </button>
      <button type="button" class="lightbox-tool" data-zoom-step="1" aria-label="Vergrößern">
        <span aria-hidden="true">+</span>
      </button>
      <button type="button" class="button button-primary lightbox-close" autofocus>
        Schließen
      </button>
    </div>
  </div>
  <div class="lightbox-stage">
    <img class="lightbox-image" alt="" />
  </div>
  <p class="sr-only" aria-live="polite" data-zoom-status></p>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.querySelector('.lightbox');
    if (!dialog || typeof dialog.showModal !== 'function') return;

    const stage = dialog.querySelector('.lightbox-stage');
    const image = dialog.querySelector('.lightbox-image');
    const caption = dialog.querySelector('.lightbox-caption');
    const level = dialog.querySelector('.lightbox-level');
    const status = dialog.querySelector('[data-zoom-status]');
    const steps = [1, 1.5, 2, 3, 4];
    let step = 0;
    let opener = null;

    // The fitted width: the largest the picture can be while all of it shows.
    const fittedWidth = () => {
      const room = stage.getBoundingClientRect();
      const styles = getComputedStyle(stage);
      const width = room.width - parseFloat(styles.paddingLeft) - parseFloat(styles.paddingRight);
      const height = room.height - parseFloat(styles.paddingTop) - parseFloat(styles.paddingBottom);
      const ratio = image.naturalWidth / image.naturalHeight || 1;
      return Math.max(1, Math.min(width, height * ratio, image.naturalWidth || width));
    };

    const apply = (keepCentre) => {
      const before = keepCentre && {
        x: (stage.scrollLeft + stage.clientWidth / 2) / stage.scrollWidth,
        y: (stage.scrollTop + stage.clientHeight / 2) / stage.scrollHeight,
      };
      const zoom = steps[step];
      image.style.width = `${Math.round(fittedWidth() * zoom)}px`;
      dialog.toggleAttribute('data-zoomed', step > 0);
      level.textContent = `${Math.round(zoom * 100)} %`;
      dialog.querySelector('[data-zoom-step="-1"]').disabled = step === 0;
      dialog.querySelector('[data-zoom-step="1"]').disabled = step === steps.length - 1;
      if (before) {
        stage.scrollLeft = before.x * stage.scrollWidth - stage.clientWidth / 2;
        stage.scrollTop = before.y * stage.scrollHeight - stage.clientHeight / 2;
      }
    };

    const zoomTo = (next) => {
      step = Math.max(0, Math.min(steps.length - 1, next));
      apply(true);
      status.textContent = `Vergrößerung ${Math.round(steps[step] * 100)} Prozent`;
    };

    document.addEventListener('click', (event) => {
      const link = event.target.closest('a[data-zoom]');
      // A click with a modifier key keeps its usual meaning: a new tab.
      if (!link || event.ctrlKey || event.metaKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();

      const shown = link.querySelector('img');
      const figure = link.closest('figure');
      opener = link;
      step = 0;
      image.alt = shown ? shown.alt : '';
      image.style.width = '';
      // The caption holds the badge and the text as separate spans; joined
      // without a gap they would read as one word.
      const parts = figure?.querySelectorAll('figcaption > *') ?? [];
      caption.textContent = Array.from(parts, (part) => part.textContent.trim()).join(': ');
      image.onload = () => apply(false);
      image.src = link.href;
      dialog.showModal();
      if (image.complete) apply(false);
    });

    dialog.querySelectorAll('[data-zoom-step]').forEach((button) => {
      button.addEventListener('click', () => zoomTo(step + Number(button.dataset.zoomStep)));
    });
    level.addEventListener('click', () => zoomTo(0));
    image.addEventListener('click', () => zoomTo(step === 0 ? 2 : 0));

    dialog.addEventListener('keydown', (event) => {
      if (event.key === '+' || event.key === '=') zoomTo(step + 1);
      else if (event.key === '-') zoomTo(step - 1);
      else if (event.key === '0') zoomTo(0);
      else return;
      event.preventDefault();
    });

    dialog.querySelector('.lightbox-close').addEventListener('click', () => dialog.close());

    // A click on the dark area around the picture closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || event.target === stage) dialog.close();
    });

    // A turned phone or a resized window fits the picture again at its step.
    window.addEventListener('resize', () => {
      if (dialog.open) apply(false);
    });

    // Escape closes the dialog natively. Either way the focus goes back to the
    // picture that was opened, so a keyboard user carries on where they were.
    dialog.addEventListener('close', () => {
      image.removeAttribute('src');
      image.onload = null;
      opener?.focus();
      opener = null;
    });
  })();
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ink);
    color: var(--ink-on-dark);
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
  }

  .lightbox::backdrop {
    background: rgb(27 36 48 / 0.85);
  }

  .lightbox-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-s);
    padding: var(--space-xs) var(--space-s);
    border-bottom: 1px solid rgb(244 241 234 / 0.15);
  }

  .lightbox-caption {
    margin: 0;
    flex: 1 1 16rem;
    font-size: var(--font-s);
    color: var(--ink-muted-on-dark);
  }

  .lightbox-tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-inline-start: auto;
  }

  .lightbox-tool {
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.6rem;
    border: 1px solid rgb(244 241 234 / 0.3);
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--ink-on-dark);
    font: inherit;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  .lightbox-tool > span {
    font-size: 1.4rem;
    line-height: 1;
  }

  .lightbox-tool:hover:not(:disabled) {
    background: rgb(244 241 234 / 0.1);
  }

  .lightbox-tool:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .lightbox-tool:focus-visible,
  .lightbox-close:focus-visible {
    outline: 3px solid var(--copper-light);
    outline-offset: 2px;
  }

  /* The stage takes all the height that is left. Fitted, the picture sits in
   * its middle; zoomed, the stage scrolls in both directions. */
  .lightbox-stage {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    display: grid;
    place-items: center;
    padding: var(--space-s);
  }

  .lightbox[data-zoomed] .lightbox-stage {
    place-items: start;
  }

  .lightbox-image {
    display: block;
    max-width: none;
    height: auto;
    border-radius: var(--radius-s);
    background: var(--surface);
    cursor: zoom-in;
  }

  .lightbox[data-zoomed] .lightbox-image {
    cursor: zoom-out;
    margin: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] {
      animation: lightbox-in 150ms ease-out;
    }

    @keyframes lightbox-in {
      from {
        opacity: 0;
      }
    }
  }
</style>
